# Copy to .env.local. Never commit .env.local.

# Base URL of the Express API (the lekker-tours-api repo).
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the Express -> Next revalidation webhook.
# Must match REVALIDATE_SECRET in the lekker-tours-api repo's .env.
REVALIDATE_SECRET=change-me-too
